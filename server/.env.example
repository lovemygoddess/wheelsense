APP_NAME="WheelSense"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=10080

# Generate these with: php artisan evtelemetry:relay-credentials
BMS_RELAY_TOKEN=
BMS_RELAY_HMAC_SECRET=
# Optional zero-downtime credential rotation pair.
BMS_RELAY_TOKEN_NEXT=
BMS_RELAY_HMAC_SECRET_NEXT=

# Set a random value for read-only home-screen widgets.
WIDGET_TOKEN=

# Optional compatible NineCLI bridge. It is not bundled with this repository.
NINECLI_BASE_URL=http://host.docker.internal:18009
NINECLI_SERVICE_TOKEN=

# Optional integrations.
AMAP_KEY=
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=
ALERT_WEBHOOK_URL=

# All relay commands, including photo and screenshots, are disabled by default.
ENABLE_RELAY_REMOTE_CONTROL=false
# Direct vehicle commands (engine/buck/bell) are disabled by default.
ENABLE_NINEBOT_REMOTE_CONTROL=false
# Additional gate for root/system-level commands.
ENABLE_DANGEROUS_RELAY_COMMANDS=false

# Optional TPMS sensor mapping. Leave blank until the target installation has
# verified its own sensor identities and the supported 0x1E01 frame format.
TPMS_FRONT_MAC=
TPMS_REAR_MAC=
